{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "resolveJsonModule": true, "esModuleInterop": true,
    "noEmit": true, "isolatedModules": true, "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "paths": { "@shared/*": ["./src/shared/*"], "@content/*": ["./src/content/*"], "@/*": ["./src/renderer/src/*"] }
  },
  "include": ["src", "tests", "electron.vite.config.ts"]
}
